# ticketbot — local credentials.
#
#   cp .env.example .env      then fill in only what your profile actually uses.
#
# `.env` is git-ignored. Every command loads it from the current directory before
# anything else runs; use `--env-file PATH` for one somewhere else, or
# `--no-env-file` to ignore it. A name already set in your real environment always
# wins, so `.env` never shadows what CI or your shell exported.
#
# Nothing here is required to try ticketbot out: the offline profile needs no keys.
#
#   ticketbot run -c profiles/file-text-none.yaml --input-text "Add a /health endpoint"
#
# Profiles reference these as ${NAME}. The name is arbitrary — the loader never
# interprets it — so if you prefer different names, change them in both places.


# ── Models ────────────────────────────────────────────────────────────────────
# Anthropic. Read directly by the SDK, so exporting it is enough; a profile only
# needs `api_key: ${ANTHROPIC_API_KEY}` if you want the reference to be explicit.
ANTHROPIC_API_KEY=sk-ant-...

# An OpenAI-compatible endpoint (profiles/github-codex.yaml). Works with anything
# that speaks /chat/completions — OpenAI, a local llama.cpp/vLLM/Ollama server, a
# gateway. This is the "any AI" path.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=

# The `peer` slot: the second-vendor reviewer in profiles/jira-claude-solari.yaml.
# Point it at a DIFFERENT vendor than the coder — a reviewer from the same model
# that wrote the code agrees with itself too often.
PEER_BASE_URL=
PEER_API_KEY=


# ── Solari runtime (sandboxes, cloud browsers, desktops) ──────────────────────
# ONE key covers all three modes. Needed only by `runtime: {type: solari}` —
# profiles/file-solari-desktop.yaml and profiles/jira-claude-solari.yaml.
# Read straight from the environment by the adapter. Get one at console.getsolari.com.
SOLARI_API_KEY=slr_live_...


# ── Jira (source + sink) ──────────────────────────────────────────────────────
# Jira Cloud REST v3 basic auth: your account email plus an API token from
# id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# The account ticketbot assigns an issue to when it claims one. Find it in the URL
# of the bot user's Jira profile. Without it, claiming only transitions the issue
# and logs a warning.
JIRA_BOT_ACCOUNT_ID=


# ── GitHub (PR sink + repo adapter) ───────────────────────────────────────────
# Used by the `gh` CLI when it is on PATH, else for REST directly. A fine-grained
# token needs Contents: read/write and Pull requests: read/write on the target repo.
# If you are already signed in with `gh auth login`, you can leave this unset.
GITHUB_TOKEN=
